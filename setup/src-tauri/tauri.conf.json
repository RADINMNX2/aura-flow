{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flow-setup",
  "version": "1.0.0",
  "identifier": "studio.aura.flow.setup",
  "build": {
    "beforeDevCommand": "node setup/dev.mjs",
    "devUrl": "http://127.0.0.1:4212/setup/",
    "beforeBuildCommand": "node setup/tools/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "flow. setup",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "maximizable": false,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "RADINMNX",
    "copyright": "Copyright © 2026 RADINMNX",
    "shortDescription": "flow. installer",
    "license": "MIT"
  }
}
