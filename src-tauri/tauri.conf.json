{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flow",
  "version": "1.0.0",
  "identifier": "studio.aura.flow",
  "build": {
    "beforeDevCommand": "node server.mjs",
    "devUrl": "http://127.0.0.1:4211",
    "beforeBuildCommand": "node tools/build-dist.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "flow. frame interpolation studio",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "RADINMNX",
    "copyright": "Copyright © 2026 RADINMNX",
    "category": "Video",
    "shortDescription": "frame interpolation studio",
    "longDescription": "A local, GPU frame-interpolation studio. Probe, plan, interpolate with RIFE or DAIN, encode, and compare - nothing leaves the machine.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
